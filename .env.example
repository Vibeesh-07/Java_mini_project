# ReFind Environment Configuration Example
# Copy to .env for local adjustments; do NOT commit live production secrets.

# Application Server Port (Railway injects PORT automatically)
PORT=8080

# Database Configuration (Docker Compose default uses service name 'db')
# For local running without Docker, change MYSQLHOST to localhost
MYSQLHOST=db
MYSQLPORT=3306
MYSQLDATABASE=refind_db
MYSQLUSER=refind_user
MYSQLPASSWORD=refind_password
# Port mapped to host machine by Docker Compose (avoids collision with local MySQL on 3306)
MYSQL_LOCAL_PORT=3307

# Initial Administrator Bootstrap
# Required to access /admin.html upon initial deployment
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_EMAIL=admin@refind.campus
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator

# Session Security
# Set to 'true' in HTTPS production environments (e.g. Railway public domain)
SESSION_COOKIE_SECURE=false

# Deterministic Matching Minimum Threshold (0-100 score)
MATCHING_MIN_SCORE=25
